<% if @query.present? %>
  <% content_for :title, "#{@query} – Suche" %>
  <% content_for :meta_description, "Suchergebnisse für „#{@query}“ im Bundesarchiv auf Quellenportal." %>
<% end %>
<% if @query.present? || @tab.present? %>
  <% content_for :site_header_extras do %>
    <form class="site-search">
      <% if @archive_node %>
        <input type="hidden" name="node_id" value="<%= @archive_node.id %>" />
      <% end %>
      <% if @date_from %>
        <input type="hidden" name="from" value="<%= @date_from %>" />
        <input type="hidden" name="to" value="<%= @date_to %>" />
      <% end %>
      <input type="text" name="q" value="<%= @query %>" placeholder="<%= t("search_placeholder", total: number_with_delimiter(@total)) %>" class="site-search__input" data-search-input />
      <button type="submit" class="site-search__button"><%= icon(:search, label: t("search_button")) %></button>
      <span class="site-search__shortcut" data-shortcut-affordance></span>
    </form>
  <% end %>
<% end %>
<% if @archive_node %>
  <p class="search__node-filter">
    Suche in: <%= link_to @archive_node.name, archive_node_path(@archive_node) %>
    (<%= link_to "Filter entfernen", root_path(q: @query, from: @date_from, to: @date_to) %>)
  </p>
<% end %>
<% if @query %>
  <% if @search_error %>
    <hr />
    <h3>Suchanfrage konnte nicht verarbeitet werden.</h3>
    <p>Bitte prüfen Sie die Syntax Ihrer Anfrage. <%= link_to "Suchhinweise", search_help_path %></p>
  <% end %>
  <% if @facets %>
    <% content_for :container_class, "container__inner--wide" %>
    <div class="search-layout">
      <%= render "facets_sidebar" %>
      <div class="search-layout__content">
  <% end %>
      <% if @total_count > 0 %>
        <%= render "pagination_controls", paginatable: @results, entry_name: { one: 'Aktenstück', other: 'Aktenstücke' }, suffix: 'top', show_sort: true %>

        <div class="pagination">
          <%= paginate @results, window: 4, outer_window: 1 %>
        </div>

        <% @results.each do |archive_file| %>
          <%= render ResultComponent.new(query: @query, archive_file: archive_file) %>
        <% end %>

        <div class="pagination">
          <%= paginate @results, window: 4, outer_window: 1 %>
        </div>

        <%= render "pagination_controls", paginatable: @results, entry_name: { one: 'Aktenstück', other: 'Aktenstücke' }, suffix: 'bottom' %>
      <% else %>
        <hr />
        <h3>Keine Akten gefunden.</h3>
      <% end %>
  <% if @facets %>
      </div>
    </div>
  <% end %>
<% else %>
  <% if @tab.present? %>
    <nav class="browse-tabs">
      <%= link_to browse_fonds_path, class: "browse-tabs__tab #{"browse-tabs__tab--active" if @tab == "fonds"}" do %>
        <%= t("browse.fonds") %> <span class="browse-tabs__count"><%= @browse_counts[:fonds] %></span>
      <% end %>
      <%= link_to browse_origins_path, class: "browse-tabs__tab #{"browse-tabs__tab--active" if @tab == "origins"}" do %>
        <%= t("browse.origins") %> <span class="browse-tabs__count"><%= @browse_counts[:origins] %></span>
      <% end %>
      <%= link_to browse_dates_path, class: "browse-tabs__tab #{"browse-tabs__tab--active" if @tab == "dates"}" do %>
        <%= t("browse.dates") %> <span class="browse-tabs__count"><%= @browse_counts[:decades] %></span>
      <% end %>
    </nav>
  <% end %>
  <% case @tab %>
  <% when "fonds" %>
    <%= render "browse_fonds" %>
  <% when "origins" %>
    <%= render "browse_origins" %>
  <% when "dates" %>
    <%= render "browse_dates" %>
  <% else %>
    <section class="landing">
      <h1 class="landing__wordmark">Quellenportal</h1>
      <p class="landing__tagline">Bundesarchiv-Bestände durchsuchen, <%= number_with_delimiter(@total) %> Aktenstücke</p>

      <form class="landing__search">
        <input type="text" name="q" placeholder="<%= t("search_placeholder", total: number_with_delimiter(@total)) %>" class="landing__search-input" data-search-input>
        <button type="submit" class="landing__search-button"><%= icon(:search, label: t("search_button")) %> <%= t("search_button") %></button>
      </form>

      <p class="landing__examples">
        <span class="landing__examples-label">Beispiele:</span>
        <%= link_to "Wiederaufbau Berlin", root_path(q: "Wiederaufbau Berlin"), class: "landing__example" %>
        <%= link_to "Reichsbahn", root_path(q: "Reichsbahn"), class: "landing__example" %>
        <%= link_to %("Hans Globke"), root_path(q: '"Hans Globke"'), class: "landing__example" %>
      </p>

      <p class="landing__section-label">Stöbern</p>
      <nav class="landing__browse">
        <%= link_to browse_fonds_path, class: "landing__browse-row" do %>
          <span class="landing__browse-text">
            <strong><%= t("browse.fonds") %></strong>
            <span class="landing__browse-desc">die Tektonik des Archivs</span>
          </span>
          <span class="landing__browse-count"><%= number_with_delimiter(@browse_counts[:fonds]) %></span>
          <%= icon("arrow-right") %>
        <% end %>
        <%= link_to browse_origins_path, class: "landing__browse-row" do %>
          <span class="landing__browse-text">
            <strong><%= t("browse.origins") %></strong>
            <span class="landing__browse-desc">wer hat sie erstellt</span>
          </span>
          <span class="landing__browse-count"><%= number_with_delimiter(@browse_counts[:origins]) %></span>
          <%= icon("arrow-right") %>
        <% end %>
        <%= link_to browse_dates_path, class: "landing__browse-row" do %>
          <span class="landing__browse-text">
            <strong><%= t("browse.dates") %></strong>
            <span class="landing__browse-desc">800 bis heute</span>
          </span>
          <span class="landing__browse-count"><%= number_with_delimiter(@browse_counts[:decades]) %></span>
          <%= icon("arrow-right") %>
        <% end %>
      </nav>

      <hr class="title-spacer">
      <h2>Was ist Quellenportal?</h2>
      <p>
        Quellenportal bietet eine einfache und schnelle Möglichkeit, die Bestände des Bundesarchivs zu durchsuchen.
        Dieses Angebot richtet sich vor allem an Personen, die für ihre Recherchen exakte textuelle Übereinstimmungen suchen und große Mengen an Ergebnissen schnell sichten möchten.
        Die hierfür benötigten Erschließungsinformationen stammen aus dem <a href="https://www.bundesarchiv.de/DE/Content/Artikel/Ueber-uns/Aus-unserer-Arbeit/open-data.html">Open-Data-Angebot</a> des Bundesarchivs.
      </p>
      <p>
        Gegenüber Bundessuche bietet Quellenportal folgende Erweiterungen:
      </p>
      <ul>
        <li><strong>Stöbern</strong> — Bestände, Provenienz und Zeiträume durchblättern, ohne einen Suchbegriff zu kennen</li>
        <li><strong>Bestandsnavigation</strong> — die Tektonik des Archivs als navigierbare Baumstruktur</li>
        <li><strong>Bestandsbezogene Suche</strong> — Suche auf einzelne Bestände eingrenzen</li>
        <li><strong>Suchoperatoren</strong> — AND, OR, NOT und Phrasensuche (<%= link_to "Suchhinweise", search_help_path %>)</li>
      </ul>
      <p>
        Weitere Optionen für die Suche in den Beständen des Bundesarchivs sind <a href="https://www.archivesportaleurope.net">Archives Portal Europe</a>,
        <a href="https://www.archivportal-d.de">Archivportal-D</a> und <a href="https://invenio.bundesarchiv.de">Invenio</a>.
        Invenio ist ein Angebot des Bundesarchivs und ist bei Treffern im Quellenportal verlinkt. Dort kann das Archivgut eingesehen und bestellt werden.
      </p>
    </section>
  <% end %>
<% end %>
